# ---------------------------------------------------------------------------
# Designally Knowledge Hub — CMS environment
# ---------------------------------------------------------------------------

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of this CMS server.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origin allowed to call the API from the browser (the Vite frontend).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database  (the adapter is picked from the URI scheme — no code change)
#   • file:...     → SQLite   (local dev, zero setup)
#   • postgres:... → Postgres (production, e.g. Neon)
# ---------------------------------------------------------------------------
DATABASE_URI=file:./designally-hub.db

# Production example — a Neon serverless Postgres connection string:
# DATABASE_URI=postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/dbname?sslmode=require

# ---------------------------------------------------------------------------
# File storage
#   • Leave the S3_* vars blank → uploads saved to cms/media/ on local disk.
#   • Set them → uploads go to Cloudflare R2 (or any S3-compatible bucket).
# Cloudflare R2 values (Account → R2 → bucket + API token):
# ---------------------------------------------------------------------------
# S3_BUCKET=designally-hub-media
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
