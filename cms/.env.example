# ---------------------------------------------------------------------------
# Designally Knowledge Hub — CMS environment
# ---------------------------------------------------------------------------

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of this CMS server.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origin allowed to call the API from the browser (the Vite frontend).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database  (the adapter is picked from the URI scheme — no code change)
#   • file:...     → SQLite   (local dev, zero setup)
#   • postgres:... → Postgres (production, e.g. Neon)
# ---------------------------------------------------------------------------
DATABASE_URI=file:./designally-hub.db

# Production example — a Neon serverless Postgres connection string:
# DATABASE_URI=postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/dbname?sslmode=require

# Supabase example — use the SESSION pooler (port 5432 via ...pooler.supabase.com),
# which supports the on-boot schema sync; the transaction pooler (6543) does not.
# DATABASE_URI=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional schema isolation. REQUIRED if this database is SHARED with another
# app (e.g. the Content Generator on Supabase) so the Hub never touches their
# tables. Create it first in the Supabase SQL editor:
#   create schema if not exists "hub";
# DB_SCHEMA=hub

# ---------------------------------------------------------------------------
# File storage — see src/lib/storage.ts
#   • On Vercel: Cloudflare R2, under the `hub/` prefix. REQUIRED — all five,
#     or the build fails. Some-but-not-all fails it too, naming the missing.
#   • Anywhere else: cms/media/ on local disk, with a startup warning. These
#     are IGNORED off Vercel even when set, so a local upload can never reach
#     the production bucket. Leave them out of your local .env.
# Token: R2 → Manage API tokens → "Object Read & Write", scoped to the bucket.
# R2_PUBLIC_URL is the bucket's custom domain, https, with NO path.
# ---------------------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://img.designally.co
